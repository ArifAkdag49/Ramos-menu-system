# Ramo's Sipariş Sistemi — kök .env şablonu (değersiz, commit edilir)
# .env olarak kopyala ve doldur; .env ASLA commit edilmez, değerleri sohbete yazılmaz.

# supabase.com → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# en az 10 karakter; admin oluşturulunca bu satır silinir
ADMIN_PASSWORD=

# Faz A yanıtları:
SEED_TABLE_COUNT=
STAFF_EMAIL_DOMAIN=
PRINTER_DEV_HOST=
APP_DOMAIN=
DEPLOY_SSH_KEY=
LE_EMAIL=

# Faz B doldurur (Görev 2, 4, 7; Görev 26 VAPID/WEBHOOK anahtarlarını ekler):
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
TEST_USER_PASSWORD=
DB_TESTS_ALLOWED=
