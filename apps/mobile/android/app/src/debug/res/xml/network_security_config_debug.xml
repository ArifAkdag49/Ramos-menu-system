<?xml version="1.0" encoding="utf-8"?>
<!-- YALNIZ debug derlemesi (src/debug): varsayılan kurallar (düz HTTP kapalı, sistem sertifikaları)
     + emülatörden bilgisayara (10.0.2.2) düz HTTP — sahte station-feed sunucusuyla test için. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
